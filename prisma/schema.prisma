generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("PLAYER")
  phone        String   @default("")
  elo          Int      @default(1000)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  efootball    EfootballLink?
  createdTournaments Tournament[] @relation("Organizer")
  registrations Registration[]
  matchesAsP1  Match[] @relation("P1")
  matchesAsP2  Match[] @relation("P2")
  wins         Match[] @relation("Winner")
}

model EfootballLink {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  konamiId    String
  gameId      String
  platform    String
  psnId       String   @default("")
  xboxId      String   @default("")
  steamId     String   @default("")
  status      String   @default("PENDING")
  lastSyncAt  DateTime?
  syncNote    String   @default("")
}

model Tournament {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String
  fee         Int
  maxPlayers  Int
  p1Pct       Int
  p2Pct       Int
  orgPct      Int
  type        String   @default("KNOCKOUT")
  drawDate    String   @default("")
  payNum      String   @default("")
  wa          String   @default("")
  status       String   @default("OPEN")
  rules        String   @default("Match eFootball, 2x6 min, extra time + TAB si égalité.")
  createdAt    DateTime @default(now())
  finishedAt   DateTime?
  winnerName   String   @default("")
  winnerGameId String   @default("")
  organizerId  String
  organizer   User     @relation("Organizer", fields: [organizerId], references: [id])
  registrations Registration[]
  matches     Match[]
  standings   Standing[]
}

model Standing {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  userId       String?
  playerName   String
  gameId       String     @default("")
  played       Int        @default(0)
  won          Int        @default(0)
  drawn        Int        @default(0)
  lost         Int        @default(0)
  goalsFor     Int        @default(0)
  goalsAgainst Int        @default(0)
  goalDiff     Int        @default(0)
  points       Int        @default(0)
  form         String     @default("")
  rank         Int        @default(1)
  zone         String     @default("TOP8")
  updatedAt    DateTime   @updatedAt

  @@unique([tournamentId, playerName])
}

model Registration {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  paid         Boolean    @default(false)
  createdAt    DateTime   @default(now())

  @@unique([tournamentId, userId])
}

model Match {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  round        Int
  index        Int
  p1Id         String?
  p2Id         String?
  p1           User?      @relation("P1", fields: [p1Id], references: [id])
  p2           User?      @relation("P2", fields: [p2Id], references: [id])
  p1Name       String     @default("")
  p2Name       String     @default("")
  score1       Int?
  score2       Int?
  winnerId     String?
  winner       User?      @relation("Winner", fields: [winnerId], references: [id])
  lobbyCode    String     @default("")
  hostNote     String     @default("")
  scheduledAt  DateTime?
  status       String     @default("PENDING")
  proofUrl     String     @default("")
  p1Claim1     Int?
  p1Claim2     Int?
  p2Claim1     Int?
  p2Claim2     Int?
}

model LivePulse {
  id        String   @id @default("main")
  message   String
  updatedAt DateTime @updatedAt
}

model CompetitionStore {
  id        String   @id
  data      Json
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model AnnouncementStore {
  id        String   @id
  text      String
  at        DateTime @default(now())
}

model GamerProfile {
  id           String   @id
  name         String
  phone        String
  passwordHash String   @default("")
  gameId       String
  platform     String   @default("Mobile")
  deviceBrand  String   @default("")
  deviceModel  String   @default("")
  ipAddress    String   @default("")
  city         String   @default("")
  country      String   @default("")
  countryCode  String   @default("")
  userAgent    String   @default("")
  tournaments  Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([phone])
}

model ChatMessage {
  id           String   @id @default(cuid())
  tournamentId String
  senderName   String
  senderPhone  String   @default("")
  senderGameId String   @default("")
  text         String   @default("")
  imageUrl     String   @default("")
  isAdmin      Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([tournamentId])
  @@index([createdAt])
}

model VisitorLog {
  id          String   @id @default(cuid())
  ip          String   @default("")
  city        String   @default("")
  region      String   @default("")
  country     String   @default("")
  countryCode String   @default("")
  lat         Float?
  lon         Float?
  isp         String   @default("")
  timezone    String   @default("")
  // GPS précis (navigator.geolocation)
  gpsLat      Float?
  gpsLon      Float?
  gpsAccuracy Float?
  // Fingerprint appareil
  userAgent   String   @default("")
  browser     String   @default("")
  os          String   @default("")
  device      String   @default("")
  screen      String   @default("")
  language    String   @default("")
  battery     String   @default("")
  network     String   @default("")
  // Page visitée
  page        String   @default("")
  referer     String   @default("")
  visitedAt   DateTime @default(now())

  @@index([visitedAt])
  @@index([ip])
}

