generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("PLAYER")
  phone        String   @default("")
  elo          Int      @default(1000)
  createdAt    DateTime @default(now())

  efootball    EfootballLink?
  createdTournaments Tournament[] @relation("Organizer")
  registrations Registration[]
  matchesAsP1  Match[] @relation("P1")
  matchesAsP2  Match[] @relation("P2")
  wins         Match[] @relation("Winner")
}

model EfootballLink {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  konamiId    String
  gameId      String
  platform    String
  psnId       String   @default("")
  xboxId      String   @default("")
  steamId     String   @default("")
  status      String   @default("PENDING")
  lastSyncAt  DateTime?
  syncNote    String   @default("")
}

model Tournament {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String
  fee         Int
  maxPlayers  Int
  p1Pct       Int
  p2Pct       Int
  orgPct      Int
  drawDate    String   @default("")
  payNum      String   @default("")
  wa          String   @default("")
  status      String   @default("OPEN")
  rules       String   @default("Match eFootball, 2x6 min, extra time + TAB si égalité.")
  createdAt   DateTime @default(now())
  organizerId String
  organizer   User     @relation("Organizer", fields: [organizerId], references: [id])
  registrations Registration[]
  matches     Match[]
}

model Registration {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  paid         Boolean    @default(false)
  createdAt    DateTime   @default(now())

  @@unique([tournamentId, userId])
}

model Match {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  round        Int
  index        Int
  p1Id         String?
  p2Id         String?
  p1           User?      @relation("P1", fields: [p1Id], references: [id])
  p2           User?      @relation("P2", fields: [p2Id], references: [id])
  score1       Int?
  score2       Int?
  winnerId     String?
  winner       User?      @relation("Winner", fields: [winnerId], references: [id])
  lobbyCode    String     @default("")
  hostNote     String     @default("")
  status       String     @default("PENDING")
  proofUrl     String     @default("")
  p1Claim1     Int?
  p1Claim2     Int?
  p2Claim1     Int?
  p2Claim2     Int?
}

model LivePulse {
  id        String   @id @default("main")
  message   String
  updatedAt DateTime @updatedAt
}
